# OKO API — NestJS (production / docker compose default)
FROM node:22-bookworm-slim

WORKDIR /app

COPY packages/engine/ ./packages/engine/
COPY web/domain/package.json web/domain/package-lock.json* ./web/domain/
COPY web/api/package.json web/api/package-lock.json* ./web/api/

RUN cd web/domain && npm ci --omit=dev \
  && cd ../api && npm ci --omit=dev

COPY web/domain/ ./web/domain/
COPY web/api/ ./web/api/
COPY web/portal/public/ ./web/portal/public/
COPY data/schema.postgresql.sql ./data/schema.postgresql.sql

ENV PORT=3001
ENV NODE_ENV=production

WORKDIR /app/web/api
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "start"]
